# Copy to .env and fill in. Never commit .env.
HTTP_ADDR=:8080
# Database: SQLite file for development (no server needed)...
DATABASE_URL=sqlite:./data/applyuni.db
# ...or PostgreSQL for production (adds row-level security per tenant):
# DATABASE_URL=postgres://applyuni:applyuni@localhost:5432/applyuni?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=20

# Encryption keys: "vault" (OpenBao/Vault transit, use in production) or "local" (dev only).
KMS_PROVIDER=vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_TRANSIT_KEY=applyuni-documents
# Only for KMS_PROVIDER=local:  openssl rand -base64 32
LOCAL_KEK_BASE64=

# Encrypted file storage: "s3" (MinIO) or "local".
STORAGE_PROVIDER=s3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=applyuni
S3_SECRET_KEY=applyuni-dev-secret
S3_BUCKET=applyuni-documents
S3_USE_SSL=false

# Document checks run OCR on this machine first (free; data stays here): "auto" (Apple Vision on
# macOS, Tesseract on Linux), "vision", "tesseract" or "off". What OCR can't accept goes to Claude
# (if ANTHROPIC_API_KEY is set), otherwise to manual review.
OCR_ENGINE=auto

# AI document checks. Leave empty to review documents manually.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Platform inbox domain for per-student aliases (portal verification emails).
MAIL_DOMAIN=inbox.applyuni.local

# Simulate portal submissions in development. NEVER true in production.
PORTAL_DRY_RUN=true
RUN_WORKER=true

# Mark the login cookie HTTPS-only. Set true in production (served over HTTPS).
COOKIE_SECURE=false

# Chrome used by the submission engine (empty = find google-chrome/chromium on PATH).
CHROME_PATH=

# Student platform addresses (s-…@MAIL_DOMAIN). Point the domain's MX at your
# mail provider and have it POST each message as JSON {to, from, subject, text}
# to /api/inbound/email with header X-Inbound-Secret. Needed for portals that
# email a verification code, and for reading admission decisions.
MAIL_DOMAIN=inbox.applyuni.local
INBOUND_SECRET=

# ApplyUni staff usernames (comma separated) who review documents of every applicant.
PLATFORM_ADMINS=
